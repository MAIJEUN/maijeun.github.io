---
import SiteLayout from '../layouts/SiteLayout.astro';
import { LINKS } from '../data/site';
---
<SiteLayout title="링크" description="여기저기 있는 저를 찾을 수 있는 곳">
  <section class="hero">
    <h1>링크</h1>
    <p class="muted">여기저기 있는 저를 찾을 수 있는 곳.</p>
  </section>

  <ul class="rows">
    {LINKS.map((l) => {
      const ext = /^https?:/.test(l.href);
      return (
        <li>
          <a class="row" href={l.href} {...(ext ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="row-title">{l.label}</span>
            <span class="row-meta">{l.handle} <span aria-hidden="true">↗</span></span>
          </a>
        </li>
      );
    })}
  </ul>
</SiteLayout>

<style>
  .hero { margin-bottom: 48px; }
  .hero p { margin: 0; }
  .row-meta { overflow: hidden; text-overflow: ellipsis; }
</style>
