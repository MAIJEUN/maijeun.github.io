---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;
---
<Base title={title} description={description} bare>
  <header class="page top">
    <a href="/" class="home" aria-label={`${SITE.name} 홈`}>
      <Logo size={20} />
      <span>{SITE.name}</span>
    </a>
    <nav>
      <a href="/blog">Blog</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </header>

  <main class="page">
    <slot />
  </main>

  <footer class="page foot">
    <span>© {new Date().getFullYear()} {SITE.name}</span>
    <a href="/">처음으로</a>
  </footer>
</Base>

<style>
  .page {
    max-width: 680px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 28px;
  }
  .home { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; letter-spacing: -0.01em; }
  .home :global(svg) { flex: none; }
  nav { display: flex; gap: 20px; font-size: 0.925rem; }
  nav a { color: var(--muted); transition: color 0.15s; }
  nav a:hover { color: var(--fg); }

  main.page { padding-top: 64px; padding-bottom: 96px; }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 40px;
    font-size: 0.85rem;
    color: var(--faint);
  }
  .foot a:hover { color: var(--fg); }

  @media (max-width: 480px) {
    main.page { padding-top: 44px; }
  }
</style>
