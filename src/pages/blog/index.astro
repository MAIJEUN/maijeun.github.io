---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getPosts, readingMinutes, formatDate } from '../../lib';

const posts = await getPosts();
const [latest, ...rest] = posts;
const byYear = Object.entries(
  rest.reduce<Record<string, typeof posts>>((acc, p) => {
    const y = String(p.data.date.getUTCFullYear());
    (acc[y] ??= []).push(p);
    return acc;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---
<BlogLayout title="블로그" description="생각과 기록" wide>
  <section class="hero">
    <p class="eyebrow">Journal</p>
    <h1>블로그</h1>
    <p class="lead">만든 것들에 대한 회고, 배운 것, 가끔은 그냥 생각들.</p>
    <p class="count">{posts.length}개의 글</p>
  </section>

  {latest ? (
    <a class="glass featured" href={`/blog/${latest.id}`}>
      <p class="eyebrow">Latest</p>
      <h2>{latest.data.title}</h2>
      {latest.data.description && <p class="desc">{latest.data.description}</p>}
      <div class="meta">
        <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
        <span>·</span>
        <span>{readingMinutes(latest.body)}분</span>
        {latest.data.tags.map((t) => <span class="chip">{t}</span>)}
      </div>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  ) : (
    <div class="glass empty">아직 글이 없어요.</div>
  )}

  {byYear.map(([year, list]) => (
    <section class="year">
      <h2 class="year-label">{year}</h2>
      <ul class="glass list">
        {list.map((p) => (
          <li>
            <a class="row" href={`/blog/${p.id}`}>
              <div class="row-main">
                <span class="row-title">{p.data.title}</span>
                {p.data.description && <span class="row-desc">{p.data.description}</span>}
              </div>
              <span class="row-side">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date).slice(5)}</time>
                <span class="row-min">{readingMinutes(p.body)}분</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BlogLayout>

<style>
  .hero { margin-bottom: 40px; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3rem); letter-spacing: -0.035em; margin: 0 0 10px; }
  .lead { margin: 0; color: var(--muted); font-size: 1.05rem; }
  .count { margin: 14px 0 0; font-size: 0.85rem; color: var(--faint); font-variant-numeric: tabular-nums; }

  .featured {
    --radius: 22px;
    display: block;
    padding: 28px 30px 26px;
  }
  .featured h2 { font-size: clamp(1.35rem, 3.6vw, 1.75rem); letter-spacing: -0.025em; margin: 0 0 8px; padding-right: 36px; }
  .featured .desc { margin: 0 0 18px; color: var(--muted); }
  .arrow {
    position: absolute;
    top: 26px;
    right: 26px;
    font-size: 1.2rem;
    color: var(--faint);
    transition: transform 0.2s, color 0.2s;
  }
  .featured:hover .arrow { transform: translateX(3px); color: var(--fg); }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .empty { padding: 28px; color: var(--muted); text-align: center; }

  .year { margin-top: 48px; }
  .year-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--faint);
    margin: 0 0 12px 6px;
  }
  .list { list-style: none; margin: 0; padding: 6px; }
  .list li + li { border-top: 1px solid var(--line); }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 16px;
    border-radius: 12px;
    transition: background 0.15s;
  }
  .row:hover { background: var(--row-hover); }
  .row-main { display: flex; flex-direction: column; min-width: 0; }
  .row-title { font-weight: 560; }
  .row-desc { color: var(--muted); font-size: 0.9rem; margin-top: 2px; }
  .row-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex: none;
    font-size: 0.85rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .row-min { font-size: 0.75rem; }

  @media (max-width: 520px) {
    .featured { padding: 22px 20px; }
    .arrow { top: 20px; right: 18px; }
    .row { padding: 12px 10px; }
  }
</style>
