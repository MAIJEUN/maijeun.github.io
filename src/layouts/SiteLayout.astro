---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/sns', label: 'SNS' },
];
const path = Astro.url.pathname;
---
<Base title={title} description={description} bare>
  <header class="page top">
    <a href="/" class="home" aria-label={`${SITE.name} 홈`}>
      <!-- 메인의 큰 로고와 같은 이름: 페이지를 오갈 때 로고가 이어져 움직임 -->
      <span class="mark" transition:name="site-logo"><Logo size={22} /></span>
    </a>
    <nav aria-label="사이트">
      {nav.map((n) => (
        <a href={n.href} class:list={[{ active: path.startsWith(n.href) }]} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </header>

  <main class="page">
    <slot />
  </main>

  <footer class="page foot">
    <span>© {new Date().getFullYear()} {SITE.name}</span>
    <span class="foot-links">
      <a href="/rss.xml">RSS</a>
      <a href="/">처음으로</a>
    </span>
  </footer>
</Base>

<style>
  .page {
    max-width: 880px; /* 모든 서브 페이지 같은 폭 */
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 28px;
  }
  .home { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; letter-spacing: -0.01em; }
  .mark { display: inline-flex; width: 22px; height: 22px; }
  /* 높이는 창 오른쪽 위 테마 버튼(32px)과 맞춤 */
  nav { display: flex; align-items: center; gap: 20px; min-height: 32px; font-size: 0.925rem; }
  nav a { color: var(--muted); transition: color 0.15s; }
  nav a:hover, nav a.active { color: var(--fg); }

  main.page { padding-top: 64px; padding-bottom: 96px; }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 40px;
    font-size: 0.85rem;
    color: var(--faint);
  }
  .foot-links { display: flex; gap: 16px; }
  .foot a:hover { color: var(--fg); }

  /* 창이 좁아 메뉴가 창 오른쪽 위 테마 버튼에 닿을 만하면, 버튼 자리(20 + 32 + 16px)만큼 비워 둠 */
  @media (max-width: 980px) {
    .top { padding-right: 68px; }
  }
  @media (max-width: 480px) {
    nav { gap: 16px; }
    main.page { padding-top: 44px; }
  }
</style>
