---
import { siDiscord, siGithub, siSteam, siYoutube } from 'simple-icons';
import SiteLayout from '../layouts/SiteLayout.astro';
import { LINK_GROUPS, type LinkGroup } from '../data/site';

// 서비스별 아이콘(Simple Icons, CC0)과 카드 색
const SERVICES: Record<LinkGroup['service'], { path?: string; color: string }> = {
  github: { path: siGithub.path, color: '#8b949e' },
  youtube: { path: siYoutube.path, color: '#ff0033' },
  discord: { path: siDiscord.path, color: '#5865f2' },
  steam: { path: siSteam.path, color: '#66c0f4' },
  link: { color: '#8b949e' },
};
---
<SiteLayout title="링크" description="여기저기 있는 저를 찾을 수 있는 곳" wide>
  <section class="hero">
    <h1>링크</h1>
    <p class="muted">여기저기 있는 저를 찾을 수 있는 곳.</p>
  </section>

  <div class="bento">
    {LINK_GROUPS.map((g) => {
      const svc = SERVICES[g.service];
      return (
        <div class:list={['card', { wide: g.wide, split: g.items.length > 1, compact: g.items.length === 1 }]} style={`--brand: ${svc.color}`}>
          {g.items.map((item, i) => {
            const ext = !!item.href && /^https?:/.test(item.href);
            const inner = (
              <>
                <span class="cell-top">
                  {i === 0 && svc.path ? (
                    <span class="icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22"><path d={svc.path} fill="currentColor" /></svg>
                    </span>
                  ) : <span />}
                  <span class="action">
                    {item.copy && <span class="copied" aria-live="polite"></span>}
                    {item.href ? (
                      <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    ) : (
                      <>
                        <svg aria-hidden="true" class="i-copy" viewBox="0 0 16 16" width="14" height="14"><rect x="5.5" y="5.5" width="7" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M10.5 3.5h-6a1 1 0 0 0-1 1v6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
                        <svg aria-hidden="true" class="i-done" viewBox="0 0 16 16" width="14" height="14"><path d="m4 8.5 2.5 2.5L12 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </>
                    )}
                  </span>
                </span>
                <span class="cell-body">
                  <span class="title">{item.title}</span>
                  <span class="handle">{item.handle}</span>
                  {item.note && <span class="note">{item.note}</span>}
                </span>
              </>
            );
            return item.href ? (
              <a class="cell" href={item.href} {...(ext ? { target: '_blank', rel: 'noopener' } : {})} aria-label={`${item.title} (${item.handle})`}>{inner}</a>
            ) : (
              <button class="cell" type="button" data-copy={item.copy} aria-label={`${item.title} ${item.handle} 복사`}>{inner}</button>
            );
          })}
        </div>
      );
    })}
  </div>
</SiteLayout>

<script>
  // 복사 칸: 누르면 글자를 복사하고 잠깐 '복사됨' 표시 (페이지 전환과 상관없이 한 번만 등록)
  document.addEventListener('click', async (e) => {
    const btn = (e.target as Element | null)?.closest?.<HTMLButtonElement>('button[data-copy]');
    if (!btn) return;
    const text = btn.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = Object.assign(document.createElement('textarea'), { value: text });
      document.body.append(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    const msg = btn.querySelector('.copied');
    btn.classList.add('done');
    if (msg) msg.textContent = '복사됨';
    clearTimeout(Number(btn.dataset.t));
    btn.dataset.t = String(
      setTimeout(() => {
        btn.classList.remove('done');
        if (msg) msg.textContent = '';
      }, 1600),
    );
  });
</script>

<style>
  .hero { margin-bottom: 40px; }
  .hero p { margin: 0; }

  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .card {
    --tint: color-mix(in srgb, var(--brand) 7%, var(--bg));
    --edge: color-mix(in srgb, var(--brand) 22%, var(--line));
    display: flex;
    min-height: 168px;
    border: 1px solid var(--edge);
    border-radius: 16px;
    background: var(--tint);
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .card.wide { grid-column: 1 / -1; }
  .card:hover { --edge: color-mix(in srgb, var(--brand) 45%, var(--line)); }

  .cell {
    all: unset;
    box-sizing: border-box;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 22px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .wide.split .cell:first-child { flex-grow: 1.5; } /* 넓은 카드는 첫 칸을 조금 더 넓게 */
  .cell + .cell { border-left: 1px solid var(--edge); }
  .cell:hover { background: color-mix(in srgb, var(--brand) 6%, transparent); }
  .cell:focus-visible { outline: 2px solid var(--brand); outline-offset: -2px; border-radius: 15px; }

  .cell-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 14%, transparent);
  }
  .action { display: inline-flex; align-items: center; gap: 6px; color: var(--faint); transition: color 0.2s, transform 0.2s; }
  .cell:hover .action { color: var(--fg); }
  a.cell:hover .action { transform: translate(2px, -2px); }
  .action .i-done, .cell.done .i-copy { display: none; }
  .cell.done .i-done { display: inline; color: var(--brand); }

  .cell-body { display: flex; flex-direction: column; min-width: 0; }
  .title { font-size: 1.2rem; font-weight: 650; letter-spacing: -0.02em; line-height: 1.3; }
  .handle, .note { font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .handle { color: var(--muted); margin-top: 2px; }
  .note { color: var(--faint); margin-top: 6px; }
  .copied { font-size: 0.75rem; color: var(--brand); }

  /* 칸이 하나뿐인 카드: 가로로 낮게 (아이콘 · 이름 · 버튼) */
  .compact { min-height: 0; }
  .compact .cell { flex-direction: row; align-items: center; gap: 16px; padding: 18px 22px; }
  .compact .cell-top { display: contents; }
  .compact .icon { order: 0; flex: none; }
  .compact .cell-body { order: 1; flex: 1; }
  .compact .action { order: 2; align-self: flex-start; }

  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; }
    .card { min-height: 0; }
    .cell { gap: 16px; padding: 18px; }
  }
  @media (max-width: 420px) {
    .split { flex-direction: column; }
    .cell + .cell { border-left: 0; border-top: 1px solid var(--edge); }
  }
</style>
