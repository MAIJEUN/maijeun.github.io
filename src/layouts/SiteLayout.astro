---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/links', label: 'Links' },
];
const path = Astro.url.pathname;
---
<Base title={title} description={description} bare>
  <header class="page top">
    <a href="/" class="home" aria-label={`${SITE.name} 홈`}>
      <!-- 메인의 큰 로고와 같은 이름: 페이지를 오갈 때 로고가 이어져 움직임 -->
      <span class="mark" transition:name="site-logo"><Logo size={20} /></span>
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="사이트">
      {nav.map((n) => (
        <a href={n.href} class:list={[{ active: path.startsWith(n.href) }]} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </header>

  <main class="page">
    <slot />
  </main>

  <footer class="page foot">
    <span>© {new Date().getFullYear()} {SITE.name}</span>
    <span class="foot-links">
      <a href="/rss.xml">RSS</a>
      <a href="/">처음으로</a>
    </span>
  </footer>
</Base>

<style>
  .page {
    max-width: 680px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 28px;
  }
  .home { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; letter-spacing: -0.01em; }
  .mark { display: inline-flex; width: 20px; height: 20px; }
  nav { display: flex; gap: 20px; font-size: 0.925rem; }
  nav a { color: var(--muted); transition: color 0.15s; }
  nav a:hover, nav a.active { color: var(--fg); }

  main.page { padding-top: 64px; padding-bottom: 96px; }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 40px;
    font-size: 0.85rem;
    color: var(--faint);
  }
  .foot-links { display: flex; gap: 16px; }
  .foot a:hover { color: var(--fg); }

  @media (max-width: 480px) {
    .home span:last-child { display: none; }
    nav { gap: 16px; }
    main.page { padding-top: 44px; }
  }
</style>
