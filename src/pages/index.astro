---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../data/site';
---
<Base bare>
  <main class="home">
    <h1 class="sr-only">{SITE.name}</h1>
    <div class="mark">
      <Logo class="logo" size="100%" />
      <a class="blog-link" href="/blog">blog</a>
    </div>
  </main>
  <canvas class="glass" aria-hidden="true"></canvas>
</Base>

<script>
  import { mountGlassLogo } from '../effects/glass-logo';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.glass')!;
  const logo = document.querySelector('.home .logo')!;
  mountGlassLogo(canvas, logo).catch((err) => {
    // WebGPU를 못 쓰는 환경이면 그냥 SVG 로고가 보입니다.
    console.warn('[glass-logo]', err);
    document.documentElement.classList.remove('glass-on');
  });
</script>

<style>
  .home {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  /* 로고는 화면 정가운데 그대로, 링크는 그 아래에 띄워 둠 */
  .mark { position: relative; }
  .home :global(.logo) {
    display: block;
    width: clamp(110px, 20vw, 190px);
    height: auto;
    color: var(--fg);
    transition: opacity 0.2s;
  }
  .blog-link {
    position: absolute;
    z-index: 1; /* 유리 로고 캔버스 위 */
    top: calc(100% + clamp(44px, 7vw, 64px));
    left: 50%;
    transform: translateX(-50%);
    padding: 6px 10px;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-indent: 0.24em; /* 자간 때문에 생기는 오른쪽 여백을 맞춰 가운데 정렬 */
    color: var(--faint);
    transition: color 0.2s;
    animation: fade-in 0.8s ease 1.1s both; /* 로고 등장이 끝난 뒤 서서히 */
  }
  .blog-link:hover, .blog-link:focus-visible { color: var(--fg); }
  .blog-link:focus-visible { outline: 1px solid var(--faint); outline-offset: 2px; border-radius: 4px; }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .blog-link { animation: none; } }
  .glass {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  :global(html.glass-on) .glass { opacity: 1; }
  :global(html.glass-on) .home :global(.logo) { opacity: 0; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
