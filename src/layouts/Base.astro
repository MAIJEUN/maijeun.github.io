---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE, NAV, LINKS } from '../data/site';

interface Props { title?: string; description?: string; bare?: boolean; }
const { title, description = SITE.description, bare = false } = Astro.props;
// 탭 제목은 어느 페이지든 사이트 이름으로 고정
const pageTitle = SITE.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 라이트/다크: 고른 값(저장됨)이 있으면 그것, 없으면 기기 설정. 화면이 그려지기 전에 정해서 깜빡임 없게 -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <!-- 페이지를 새로 불러오지 않고 내용만 부드럽게 바꿔 이어지게 함 -->
    <ClientRouter />
  </head>
  <body>
    {!bare && (
    <header class="wrap site-header">
      <a href="/" class="brand">{SITE.name}</a>
      <nav>
        {NAV.map((n) => (
          <a href={n.href} class:list={[{ active: path.startsWith(n.href) }]}>{n.label}</a>
        ))}
      </nav>
    </header>
    )}
    {bare ? <slot /> : (
    <main class="wrap">
      <slot />
    </main>
    )}
    {!bare && (
    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span class="foot-links">
        {LINKS.slice(0, 3).map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
        <a href="/rss.xml">RSS</a>
      </span>
    </footer>
    )}
    <!-- 홈의 유리 로고를 그리는 캔버스. 페이지가 바뀌어도 그대로 남아서 로고가 날아가는 동안에도 계속 그림 -->
    <canvas class="glass-canvas" transition:persist="glass-canvas" aria-hidden="true"></canvas>
    <script is:inline>
      // 스크롤바 자리 폭을 화면이 그려지기 전에 바로 잼 (홈 전환 버튼이 처음에 움직이지 않게)
      (function () {
        var c = document.querySelector('canvas.glass-canvas');
        if (c) document.documentElement.style.setProperty('--gutter', Math.max(0, c.getBoundingClientRect().left) + 'px');
      })();
    </script>
  </body>
</html>

<script>
  // 로고 연출 (모든 페이지 공통, 페이지를 오가도 한 번만 실행됨)
  // - 홈의 유리 로고는 페이지가 바뀌어도 남는 캔버스(.glass-canvas)에 그림.
  // - 홈 ↔ 다른 페이지로 갈 때: 유리 로고가 날아가며 동시에 크기·유리↔평면·회전이 바뀜.
  // - WebGPU가 없거나 아직 준비가 안 됐으면: 평면 SVG 로고가 페이지 전환으로 날아감 (to-home / from-home 표시로
  //   global.css 가 큰 쪽의 선명한 이미지만 쓰게 함).
  import type { GlassLogo, Rect } from '../effects/glass-logo';

  // ── 라이트/다크 전환 ──
  const THEME_KEY = 'theme';
  const stored = () => {
    try {
      const t = localStorage.getItem(THEME_KEY);
      return t === 'light' || t === 'dark' ? t : null;
    } catch {
      return null;
    }
  };
  const systemTheme = () => (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const currentTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  const labelToggles = () => {
    const label = currentTheme() === 'dark' ? '라이트 모드로 바꾸기' : '다크 모드로 바꾸기';
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-label', label));
  };
  const applyTheme = (t: 'light' | 'dark') => {
    document.documentElement.dataset.theme = t;
    labelToggles();
    dispatchEvent(new CustomEvent('site-themechange', { detail: t })); // 유리 로고 색도 바꾸게
  };
  labelToggles();
  document.addEventListener('click', (e) => {
    if (!(e.target as Element | null)?.closest?.('[data-theme-toggle]')) return;
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch {}
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      doc.startViewTransition(() => applyTheme(next)); // 화면이 부드럽게 바뀜
    } else {
      applyTheme(next);
    }
  });
  // 고른 적이 없으면 기기 설정이 바뀔 때 따라감
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!stored()) applyTheme(systemTheme());
  });
  // 페이지가 바뀔 때 <html> 속성이 새 페이지 것으로 바뀌므로, 새 페이지에도 지금 테마를 미리 넣어 둠
  document.addEventListener('astro:before-swap', (e) => {
    (e as Event & { newDocument: Document }).newDocument.documentElement.dataset.theme = currentTheme();
  });
  document.addEventListener('astro:after-swap', labelToggles);

  // ── 테마 버튼이 홈 → 다른 페이지로 날아와 헤더 메뉴를 밀어내는 연출 ──
  // 버튼은 페이지 전환(global.css 의 theme-toggle)으로 움직이고, 메뉴는 여기서 같은 곡선으로 계산해 맞물리게 함.
  // 메뉴 하나하나가 실제 크기(히트박스)를 가진 물체: 처음엔 '버튼이 없을 때 자리'(버튼 폭만큼 오른쪽)에 가만히 있다가,
  // 날아온 버튼의 왼쪽 끝이 SNS 의 오른쪽 끝에 닿는 순간 튕겨 나가고, SNS 가 Projects 에, Projects 가 Blog 에
  // 부딪히며 운동량을 넘겨줌 (뉴턴의 요람처럼 끝에 있는 것이 가장 멀리 날아감). 무거운 정도는 폭에 비례.
  // 미끄러지는 동안은 마찰이 약해 멀리 가고, 멈춘 뒤에는 강한 용수철이 제자리로 튕기듯 끌어와 몇 번 출렁이다 멈춤.
  const FLY_MS = 520; // global.css 의 animation-duration 과 같게
  const cubicBezier = (x1: number, y1: number, x2: number, y2: number) => {
    const bx = (t: number) => 3 * x1 * t * (1 - t) ** 2 + 3 * x2 * t * t * (1 - t) + t ** 3;
    const by = (t: number) => 3 * y1 * t * (1 - t) ** 2 + 3 * y2 * t * t * (1 - t) + t ** 3;
    const dbx = (t: number) => 3 * x1 * (1 - t) ** 2 + 6 * (x2 - x1) * t * (1 - t) + 3 * (1 - x2) * t * t;
    return (x: number) => {
      let t = x;
      for (let i = 0; i < 8; i++) {
        const d = dbx(t);
        if (Math.abs(d) < 1e-6) break;
        t = Math.min(1, Math.max(0, t - (bx(t) - x) / d));
      }
      return by(t);
    };
  };
  const flyEase = cubicBezier(0.33, 1, 0.68, 1); // global.css 의 animation-timing-function 과 같게
  let toggleFrom: DOMRect | null = null;
  let pushAnim = 0;

  const pushNavLinks = (dx0: number, start: Promise<unknown>) => {
    const btn = document.querySelector<HTMLElement>('.top [data-theme-toggle]');
    const links = [...document.querySelectorAll<HTMLElement>('.top nav a')];
    if (!btn || !links.length || dx0 <= 0) return;
    const n = links.length;
    const box = links.map((el) => el.getBoundingClientRect()); // 제자리 히트박스
    const b = btn.getBoundingClientRect();
    const P = b.right - box[n - 1].right; // 버튼이 없을 때 메뉴가 있을 자리까지 거리 (= 버튼 폭 + 간격)
    const reach = b.left - box[n - 1].right; // 제자리 버튼과 맨 오른쪽 메뉴 사이 간격
    const gap = box.slice(1).map((r, i) => r.left - box[i].right); // 메뉴 사이 간격 (제자리 기준)
    const inv = box.map((r) => 1 / Math.max(8, r.width)); // 1/질량 (폭에 비례하는 무게)
    const set = (el: HTMLElement, x: number) => (el.style.transform = Math.abs(x) > 0.01 ? `translateX(${x.toFixed(2)}px)` : '');
    const x = links.map(() => P), v = links.map(() => 0), moving = links.map(() => false), back = links.map(() => false);
    links.forEach((el) => set(el, P));
    const id = ++pushAnim;

    const K = 60; // 밀려 나가는 동안 제자리로 끌어당기는 힘 (작을수록 멀리)
    const SLIDE = 2 * 0.25 * Math.sqrt(K); // 밀려 나갈 때 마찰 (작을수록 멀리)
    const K_BACK = 300; // 돌아올 때 용수철 세기 (클수록 빠르게 튕겨 돌아옴)
    const DAMP_BACK = 2 * 0.4 * Math.sqrt(K_BACK); // 돌아올 때 감쇠 (작을수록 제자리를 지나쳐 더 출렁임)
    const BOUNCE = 0.95; // 부딪힐 때 튕기는 정도 (1 = 완전 탄성)
    const SOFT = 30; // 이보다 느리게 닿으면 튕기지 않고 그냥 맞붙음 (떨림 방지, px/s)
    const H = 0.002; // 2ms 단위로 계산
    const btnX = (ms: number) => (ms < FLY_MS ? dx0 * (1 - flyEase(Math.max(0, ms) / FLY_MS)) : 0); // 버튼이 제자리에서 얼마나 오른쪽에 있는지

    const tick = (ms: number) => {
      const xb = btnX(ms);
      const vb = (btnX(ms + 1) - btnX(ms - 1)) * 500; // px/s
      for (let i = 0; i < n; i++) {
        if (!moving[i]) continue;
        if (x[i] < 0 && v[i] > 0) back[i] = true; // 가장 멀리 간 뒤 돌아오기 시작함
        v[i] += (-(back[i] ? K_BACK : K) * x[i] - (back[i] ? DAMP_BACK : SLIDE) * v[i]) * H;
        x[i] += v[i] * H;
      }
      for (let it = 0; it < 4; it++) {
        // 버튼(움직임이 정해진 무거운 물체) ↔ 맨 오른쪽 메뉴
        const lim = xb + reach;
        if (x[n - 1] > lim) {
          x[n - 1] = lim;
          moving[n - 1] = true;
          if (v[n - 1] > vb) v[n - 1] = vb - (v[n - 1] - vb > SOFT ? BOUNCE : 0) * (v[n - 1] - vb);
        }
        // 메뉴 ↔ 메뉴: 히트박스가 겹치면 무게 비율대로 밀어내고 운동량을 주고받음
        for (let i = n - 2; i >= 0; i--) {
          const over = x[i] - gap[i] - x[i + 1];
          if (over <= 0) continue;
          const sum = inv[i] + inv[i + 1];
          x[i] -= (over * inv[i]) / sum;
          x[i + 1] += (over * inv[i + 1]) / sum;
          moving[i] = moving[i + 1] = true;
          const rel = v[i + 1] - v[i]; // 음수면 서로 다가오는 중
          if (rel < 0) {
            const j = (-(1 + (rel < -SOFT ? BOUNCE : 0)) * rel) / sum;
            v[i] -= j * inv[i];
            v[i + 1] += j * inv[i + 1];
          }
        }
      }
    };

    start.then(() => {
      const t0 = performance.now();
      let sim = 0; // 계산이 진행된 시간 (ms)
      const step = (now: number) => {
        if (id !== pushAnim) return;
        const t = Math.min(now - t0, 4000); // 버튼 전환과 같은 시계로 (계산이 가벼워 몰아서 해도 됨)
        while (sim + H * 1000 <= t) {
          sim += H * 1000;
          tick(sim);
        }
        links.forEach((el, i) => set(el, x[i]));
        const settled = sim > FLY_MS && x.every((q) => Math.abs(q) < 0.1) && v.every((q) => Math.abs(q) < 2);
        if (settled) {
          links.forEach((el) => set(el, 0));
          return;
        }
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  };

  // 스크롤바 자리로 비워 둔 폭: 화면 전체를 덮는 고정 캔버스가 창 왼쪽 끝에서 얼마나 안쪽에서 시작하는지로 잼.
  // (홈의 전환 버튼을 창 오른쪽 끝에 붙일 때 씀)
  const measureGutter = () => {
    const c = document.querySelector('canvas.glass-canvas');
    document.documentElement.style.setProperty('--gutter', `${c ? Math.max(0, c.getBoundingClientRect().left) : 0}px`);
  };
  measureGutter();
  addEventListener('resize', measureGutter);
  document.addEventListener('astro:after-swap', measureGutter);

  type PrepEvent = Event & { from: URL; to: URL };
  type SwapEvent = Event & { viewTransition?: ViewTransition };

  const html = document.documentElement;
  const isHome = (u: URL) => u.pathname === '/';
  const canvasEl = () => document.querySelector<HTMLCanvasElement>('canvas.glass-canvas');
  const homeLogo = () => document.querySelector<HTMLElement>('.home .logo');
  const headerMark = () => document.querySelector<HTMLElement>('.top .mark');
  const rectOf = (el: Element): Rect => {
    const r = el.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width };
  };

  // 유리 로고 렌더러는 필요할 때 한 번만 만듦 (WebGPU 코드는 이때 따로 불러옴)
  let glass: GlassLogo | null = null;
  let glassReady: Promise<GlassLogo | null> | null = null;
  const ensureGlass = () => {
    const canvas = canvasEl();
    if (!canvas || !('gpu' in navigator) || matchMedia('(prefers-reduced-motion: reduce)').matches) return Promise.resolve(null);
    glassReady ??= import('../effects/glass-logo')
      .then((m) => m.createGlassLogo(canvas))
      .then((g) => (glass = g))
      .catch(() => null); // WebGPU 장치를 못 얻으면 평면 SVG 로고만 씀
    return glassReady;
  };

  const showGlassAtHome = (from?: Rect) => {
    const logo = homeLogo();
    if (!glass?.alive || !logo) return;
    glass.enterHome(() => rectOf(homeLogo() ?? logo), { from, ms: from ? 480 : 750 });
    // 첫 프레임은 평면 SVG 로고와 같은 모습이라 바로 바꿔도 티가 나지 않음
    requestAnimationFrame(() => requestAnimationFrame(() => glass?.alive && html.classList.add('glass-on')));
  };

  // 처음 접속
  let first = true;
  document.addEventListener('astro:page-load', async () => {
    if (!first) return;
    first = false;
    if (homeLogo()) {
      if (await ensureGlass()) showGlassAtHome();
    } else {
      // 다른 페이지로 처음 들어왔으면 한가할 때 미리 준비 (홈으로 갈 때 바로 쓰도록)
      ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(() => ensureGlass());
    }
  });

  // 페이지 이동
  let nav: { fromHome: boolean; toHome: boolean; glass: boolean; fromRect?: Rect } | null = null;
  let vt: ViewTransition | undefined;

  document.addEventListener('astro:before-preparation', (e) => {
    const { from, to } = e as PrepEvent;
    const fromHome = isHome(from);
    const toHome = isHome(to);
    const crossing = fromHome !== toHome;
    // 유리 로고로 날릴 수 있는지: 나갈 땐 홈에 유리 로고가 떠 있어야, 올 땐 렌더러가 준비돼 있어야
    const useGlass = crossing && !!glass?.alive && (fromHome ? glass.atHome : true);
    nav = { fromHome, toHome, glass: useGlass };
  });

  // 화면을 캡처하기 직전 (아직 이전 페이지)
  document.addEventListener('astro:after-preparation', () => {
    toggleFrom = document.querySelector('[data-theme-toggle]')?.getBoundingClientRect() ?? null;
    if (!nav?.glass || !glass) return;
    if (nav.fromHome) {
      // 홈 로고는 페이지 전환으로 날리지 않음 (유리 로고가 대신 날아감)
      const wrap = document.querySelector<HTMLElement>('.home .logo-wrap');
      if (wrap) wrap.style.viewTransitionName = 'none';
    } else {
      // 헤더 로고 자리에 똑같은 평면 로고를 캔버스에 그려 두고, 진짜 헤더 로고는 숨김
      const mark = headerMark();
      if (mark) {
        nav.fromRect = rectOf(mark);
        mark.style.viewTransitionName = 'none';
        mark.style.visibility = 'hidden';
        glass.holdAt(nav.fromRect);
        html.classList.add('glass-on');
      }
    }
  });

  document.addEventListener('astro:before-swap', (e) => {
    vt = (e as SwapEvent).viewTransition;
  });

  // 새 페이지로 바뀐 직후 (전환 애니메이션 시작 전)
  document.addEventListener('astro:after-swap', () => {
    // 다른 페이지에서 홈으로 돌아온 경우: 로고 아래 링크를 기다리지 않고 바로 보여줌
    if (homeLogo()) html.classList.add('returning');
    // 홈 → 다른 페이지: 테마 버튼이 날아와 헤더 메뉴를 밀어냄
    if (nav?.fromHome && !nav.toHome && toggleFrom && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const btn = document.querySelector('.top [data-theme-toggle]');
      if (btn) pushNavLinks(toggleFrom.left - btn.getBoundingClientRect().left, vt ? vt.ready.catch(() => {}) : Promise.resolve());
    }
    toggleFrom = null;
    const n = nav;
    nav = null;
    if (!n) return;
    if (n.glass && glass) {
      html.classList.add('glass-on'); // 새 페이지로 바뀌며 <html> 속성이 초기화되므로 다시
      if (n.fromHome) {
        // 홈 → 다른 페이지: 헤더 로고 자리로 날아가며 작아지고 평면이 됨. 도착하면 진짜 헤더 로고로 바꿈
        const mark = headerMark();
        if (!mark) return;
        mark.style.viewTransitionName = 'none';
        mark.style.visibility = 'hidden';
        glass.leave(rectOf(mark), 420).then(() => {
          mark.style.visibility = '';
          if (!glass?.atHome) html.classList.remove('glass-on');
        });
      } else {
        // 다른 페이지 → 홈: 헤더 로고 자리에서 날아오며 커지고 유리가 됨
        const wrap = document.querySelector<HTMLElement>('.home .logo-wrap');
        if (wrap) wrap.style.viewTransitionName = 'none';
        showGlassAtHome(n.fromRect);
      }
      return;
    }
    // 유리 로고 없이: 평면 SVG 로고를 페이지 전환으로 날림
    const cls = n.toHome && !n.fromHome ? 'to-home' : n.fromHome && !n.toHome ? 'from-home' : '';
    if (cls) {
      html.classList.add(cls);
      const done = () => html.classList.remove(cls);
      if (vt) vt.finished.finally(done);
      else setTimeout(done, 1000);
    }
    // 렌더러가 아직 없으면 지금 준비해 두고, 홈에 왔다면 전환이 끝난 뒤 유리로 바꿈
    ensureGlass().then(async (g) => {
      if (!g || !n.toHome || !homeLogo()) return;
      await vt?.finished.catch(() => {});
      if (homeLogo()) showGlassAtHome();
    });
  });
</script>

