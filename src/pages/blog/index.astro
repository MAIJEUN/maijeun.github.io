---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPosts, readingMinutes, formatDate } from '../../lib';

const posts = await getPosts();
const byYear = Object.entries(
  posts.reduce<Record<string, typeof posts>>((acc, p) => {
    const y = String(p.data.date.getUTCFullYear());
    (acc[y] ??= []).push(p);
    return acc;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---
<SiteLayout title="블로그" description="생각과 기록">
  <section class="hero">
    <h1>블로그</h1>
    <p class="muted">만든 것들에 대한 회고, 배운 것, 가끔은 그냥 생각들.</p>
  </section>

  {posts.length === 0 && <p class="muted">아직 글이 없어요.</p>}

  {byYear.map(([year, list]) => (
    <section class="year">
      <h2 class="label">{year}</h2>
      <ul class="rows">
        {list.map((p) => (
          <li>
            <a class="row" href={`/blog/${p.id}`}>
              <div class="row-main">
                <span class="row-title">{p.data.title}</span>
                {p.data.description && <span class="row-desc">{p.data.description}</span>}
              </div>
              <span class="row-meta">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date).slice(5)}</time>
                <span class="faint">{readingMinutes(p.body)}분</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</SiteLayout>

<style>
  .hero { margin-bottom: 48px; }
  .hero p { margin: 0; }
  .year + .year { margin-top: 48px; }
  .row-main { display: flex; flex-direction: column; min-width: 0; }
  .row-desc { color: var(--muted); font-size: 0.925rem; margin-top: 2px; }
  .row-meta { display: flex; flex-direction: column; align-items: flex-end; flex: none; }
  .row-meta .faint { font-size: 0.75rem; }
</style>
