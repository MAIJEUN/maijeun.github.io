---
interface Project { name: string; year: string; description: string; tags: string[]; href: string; }
interface Props { projects: Project[]; }
const { projects } = Astro.props;
---
<ul class="rows">
  {projects.map((p) => {
    const Tag = p.href ? 'a' : 'div';
    return (
      <li>
        <Tag class="row" {...(p.href ? { href: p.href, target: '_blank', rel: 'noopener' } : {})}>
          <div>
            <span class="row-title">{p.name}{p.href && <span class="faint"> ↗</span>}</span>
            <p class="row-desc">{p.description}</p>
            <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
          <span class="row-meta">{p.year}</span>
        </Tag>
      </li>
    );
  })}
</ul>
