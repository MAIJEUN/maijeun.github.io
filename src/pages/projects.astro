---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PROJECTS } from '../data/site';
---
<SiteLayout title="프로젝트" description="지금까지 만든 것들">
  <section class="hero">
    <h1>프로젝트</h1>
    <p class="muted">지금까지 만든 것들.</p>
  </section>

  {PROJECTS.length === 0 && <p class="muted">아직 올린 프로젝트가 없어요.</p>}

  <ul class="rows">
    {PROJECTS.map((p) => {
      const Tag = p.href ? 'a' : 'div';
      const ext = p.href && /^https?:/.test(p.href);
      return (
        <li>
          <Tag class="row" {...(p.href ? { href: p.href, ...(ext ? { target: '_blank', rel: 'noopener' } : {}) } : {})}>
            <div class="row-main">
              <span class="row-title">{p.name}{ext && <span class="faint"> ↗</span>}</span>
              <span class="row-desc">{p.description}</span>
              {p.tags.length > 0 && <span class="row-tags">{p.tags.map((t) => `#${t}`).join(' ')}</span>}
            </div>
            <span class="row-meta">{p.year}</span>
          </Tag>
        </li>
      );
    })}
  </ul>
</SiteLayout>

<style>
  .hero { margin-bottom: 48px; }
  .hero p { margin: 0; }
  .row-main { display: flex; flex-direction: column; min-width: 0; }
  .row-desc { color: var(--muted); font-size: 0.925rem; margin-top: 2px; }
  .row-tags { color: var(--faint); font-size: 0.8rem; margin-top: 6px; }
</style>
