---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE, NAV, LINKS } from '../data/site';

interface Props { title?: string; description?: string; bare?: boolean; }
const { title, description = SITE.description, bare = false } = Astro.props;
// 탭 제목은 어느 페이지든 사이트 이름으로 고정
const pageTitle = SITE.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 페이지를 새로 불러오지 않고 내용만 부드럽게 바꿔 이어지게 함 -->
    <ClientRouter />
  </head>
  <body>
    {!bare && (
    <header class="wrap site-header">
      <a href="/" class="brand">{SITE.name}</a>
      <nav>
        {NAV.map((n) => (
          <a href={n.href} class:list={[{ active: path.startsWith(n.href) }]}>{n.label}</a>
        ))}
      </nav>
    </header>
    )}
    {bare ? <slot /> : (
    <main class="wrap">
      <slot />
    </main>
    )}
    {!bare && (
    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span class="foot-links">
        {LINKS.slice(0, 3).map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
        <a href="/rss.xml">RSS</a>
      </span>
    </footer>
    )}
  </body>
</html>

<script>
  // 로고 전환 방향 표시: 홈으로 갈 때(to-home) / 홈에서 나갈 때(from-home).
  // CSS(global.css)가 이걸 보고 큰 쪽의 선명한 로고 이미지만 써서 흐릿하게 섞이지 않게 함.
  // (페이지가 바뀔 때 <html> 속성이 새 페이지 것으로 바뀌므로 바뀐 뒤에 붙이고, 전환이 끝나면 뗌)
  type PrepEvent = Event & { from: URL; to: URL };
  type SwapEvent = Event & { viewTransition?: ViewTransition };
  let dir = '';
  let vt: ViewTransition | undefined;
  document.addEventListener('astro:before-preparation', (e) => {
    const { from, to } = e as PrepEvent;
    const fromHome = from.pathname === '/';
    const toHome = to.pathname === '/';
    dir = toHome && !fromHome ? 'to-home' : fromHome && !toHome ? 'from-home' : '';
  });
  document.addEventListener('astro:before-swap', (e) => {
    vt = (e as SwapEvent).viewTransition;
  });
  document.addEventListener('astro:after-swap', () => {
    if (!dir) return;
    const html = document.documentElement;
    const cls = dir;
    html.classList.add(cls);
    const done = () => html.classList.remove(cls);
    if (vt) vt.finished.finally(done);
    else setTimeout(done, 1000);
  });
</script>

<style>
  .site-header {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-top: 28px; padding-bottom: 0; flex-wrap: wrap;
  }
  .brand { font-weight: 650; letter-spacing: -0.02em; }
  nav { display: flex; gap: 20px; font-size: 0.925rem; }
  nav a { color: var(--muted); transition: color .15s; }
  nav a:hover, nav a.active { color: var(--fg); }
  .site-footer {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-bottom: 40px; font-size: 0.85rem; color: var(--faint);
  }
  .foot-links { display: flex; gap: 16px; }
  .foot-links a:hover { color: var(--fg); }
  @media (max-width: 480px) { nav { gap: 14px; } }
</style>
