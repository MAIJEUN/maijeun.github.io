---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE, NAV, LINKS } from '../data/site';

interface Props { title?: string; description?: string; bare?: boolean; }
const { title, description = SITE.description, bare = false } = Astro.props;
// 탭 제목은 어느 페이지든 사이트 이름으로 고정
const pageTitle = SITE.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 라이트/다크: 고른 값(저장됨)이 있으면 그것, 없으면 기기 설정. 화면이 그려지기 전에 정해서 깜빡임 없게 -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <!-- 페이지를 새로 불러오지 않고 내용만 부드럽게 바꿔 이어지게 함 -->
    <ClientRouter />
  </head>
  <body>
    {!bare && (
    <header class="wrap site-header">
      <a href="/" class="brand">{SITE.name}</a>
      <nav>
        {NAV.map((n) => (
          <a href={n.href} class:list={[{ active: path.startsWith(n.href) }]}>{n.label}</a>
        ))}
      </nav>
    </header>
    )}
    {bare ? <slot /> : (
    <main class="wrap">
      <slot />
    </main>
    )}
    {!bare && (
    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span class="foot-links">
        {LINKS.slice(0, 3).map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
        <a href="/rss.xml">RSS</a>
      </span>
    </footer>
    )}
    <!-- 라이트/다크 전환 버튼: 모든 페이지에서 창 오른쪽 위 끝 같은 자리 -->
    <ThemeToggle class="site-theme" />
    <!-- 홈의 유리 로고를 그리는 캔버스. 페이지가 바뀌어도 그대로 남아서 로고가 날아가는 동안에도 계속 그림 -->
    <canvas class="glass-canvas" transition:persist="glass-canvas" aria-hidden="true"></canvas>
    <script is:inline>
      // 스크롤바 자리 폭을 화면이 그려지기 전에 바로 잼 (테마 버튼이 처음에 움직이지 않게)
      (function () {
        var c = document.querySelector('canvas.glass-canvas');
        if (c) document.documentElement.style.setProperty('--gutter', Math.max(0, c.getBoundingClientRect().left) + 'px');
      })();
    </script>
  </body>
</html>

<script>
  // 로고 연출 (모든 페이지 공통, 페이지를 오가도 한 번만 실행됨)
  // - 홈의 유리 로고는 페이지가 바뀌어도 남는 캔버스(.glass-canvas)에 그림.
  // - 홈 ↔ 다른 페이지로 갈 때: 유리 로고가 날아가며 동시에 크기·유리↔평면·회전이 바뀜.
  // - WebGPU가 없거나 아직 준비가 안 됐으면: 평면 SVG 로고가 페이지 전환으로 날아감 (to-home / from-home 표시로
  //   global.css 가 큰 쪽의 선명한 이미지만 쓰게 함).
  import type { GlassLogo, Rect } from '../effects/glass-logo';

  // ── 라이트/다크 전환 ──
  const THEME_KEY = 'theme';
  const stored = () => {
    try {
      const t = localStorage.getItem(THEME_KEY);
      return t === 'light' || t === 'dark' ? t : null;
    } catch {
      return null;
    }
  };
  const systemTheme = () => (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const currentTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  const labelToggles = () => {
    const label = currentTheme() === 'dark' ? '라이트 모드로 바꾸기' : '다크 모드로 바꾸기';
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-label', label));
  };
  const applyTheme = (t: 'light' | 'dark') => {
    document.documentElement.dataset.theme = t;
    labelToggles();
    dispatchEvent(new CustomEvent('site-themechange', { detail: t })); // 유리 로고 색도 바꾸게
  };
  labelToggles();
  document.addEventListener('click', (e) => {
    if (!(e.target as Element | null)?.closest?.('[data-theme-toggle]')) return;
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch {}
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      doc.startViewTransition(() => applyTheme(next)); // 화면이 부드럽게 바뀜
    } else {
      applyTheme(next);
    }
  });
  // 고른 적이 없으면 기기 설정이 바뀔 때 따라감
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!stored()) applyTheme(systemTheme());
  });
  // 페이지가 바뀔 때 <html> 속성이 새 페이지 것으로 바뀌므로, 새 페이지에도 지금 테마를 미리 넣어 둠
  document.addEventListener('astro:before-swap', (e) => {
    (e as Event & { newDocument: Document }).newDocument.documentElement.dataset.theme = currentTheme();
  });
  document.addEventListener('astro:after-swap', labelToggles);

  // 스크롤바 자리로 비워 둔 폭: 화면 전체를 덮는 고정 캔버스가 창 왼쪽 끝에서 얼마나 안쪽에서 시작하는지로 잼.
  // (테마 버튼을 창 오른쪽 끝에 붙일 때 씀)
  const measureGutter = () => {
    const c = document.querySelector('canvas.glass-canvas');
    document.documentElement.style.setProperty('--gutter', `${c ? Math.max(0, c.getBoundingClientRect().left) : 0}px`);
  };
  measureGutter();
  addEventListener('resize', measureGutter);
  document.addEventListener('astro:after-swap', measureGutter);

  type PrepEvent = Event & { from: URL; to: URL };
  type SwapEvent = Event & { viewTransition?: ViewTransition };

  const html = document.documentElement;
  const isHome = (u: URL) => u.pathname === '/';
  const canvasEl = () => document.querySelector<HTMLCanvasElement>('canvas.glass-canvas');
  const homeLogo = () => document.querySelector<HTMLElement>('.home .logo');
  const headerMark = () => document.querySelector<HTMLElement>('.top .mark');
  const rectOf = (el: Element): Rect => {
    const r = el.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width };
  };

  // '동작 줄이기' 설정이면 유리 로고는 그대로 쓰되 날아가는 연출 없이 바로 바뀜
  const calm = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const flyMs = (ms: number) => (calm() ? 1 : ms);

  // 유리 로고 진단 기록 (주소 끝에 #glass-debug 를 붙이면 화면 왼쪽 아래에 기록이 쌓여 보임 — 휴대폰에서 원인 확인용).
  // 덮어쓰지 않고 시간과 함께 한 줄씩 쌓고, 글자를 선택하거나 '복사' 버튼으로 통째로 복사할 수 있음
  // 한 번 켜면 다른 페이지로 가도 (주소에서 #glass-debug 가 빠져도) 계속 보임
  let debug = location.hash.includes('glass-debug');
  addEventListener('hashchange', () => {
    if (location.hash.includes('glass-debug')) {
      debug = true;
      renderLog();
    }
  });
  const debugOn = () => debug;
  const logLines: string[] = [];
  const startedAt = performance.now();
  const renderLog = () => {
    if (!debugOn()) return;
    let box = document.getElementById('glass-debug');
    if (!box) {
      box = document.createElement('div');
      box.id = 'glass-debug';
      box.style.cssText =
        'position:fixed;left:8px;bottom:8px;z-index:9;width:min(560px,calc(100vw - 16px));border-radius:8px;font:11px/1.45 ui-monospace,monospace;background:var(--fg);color:var(--bg);opacity:.92;user-select:text;-webkit-user-select:text';
      const bar = document.createElement('div');
      bar.style.cssText = 'display:flex;gap:8px;align-items:center;padding:6px 8px 0';
      const title = document.createElement('b');
      title.textContent = 'glass log';
      title.style.flex = '1';
      const btn = (label: string, onClick: (b: HTMLButtonElement) => void) => {
        const b = document.createElement('button');
        b.textContent = label;
        b.style.cssText = 'font:inherit;padding:2px 8px;border-radius:4px;border:1px solid currentColor;background:transparent;color:inherit;cursor:pointer';
        b.addEventListener('click', () => onClick(b));
        return b;
      };
      const copy = btn('복사', async (b) => {
        const text = [navigator.userAgent, ...logLines].join('\n');
        try {
          await navigator.clipboard.writeText(text);
          b.textContent = '복사됨';
        } catch {
          // 클립보드를 못 쓰면 글자를 전부 선택해 둠 (길게 눌러 복사)
          const sel = getSelection();
          const range = document.createRange();
          range.selectNodeContents(box!.querySelector('pre')!);
          sel?.removeAllRanges();
          sel?.addRange(range);
          b.textContent = '선택됨';
        }
        setTimeout(() => (b.textContent = '복사'), 1500);
      });
      const fold = btn('접기', (b) => {
        const pre = box!.querySelector('pre')!;
        const hidden = pre.style.display === 'none';
        pre.style.display = hidden ? '' : 'none';
        b.textContent = hidden ? '접기' : '펼치기';
      });
      const pre = document.createElement('pre');
      pre.style.cssText = 'margin:0;padding:6px 8px 8px;max-height:40vh;overflow:auto;white-space:pre-wrap;word-break:break-all';
      bar.append(title, copy, fold);
      box.append(bar, pre);
      document.body.append(box);
    }
    const pre = box.querySelector('pre')!;
    const atBottom = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 4;
    pre.textContent = logLines.join('\n');
    if (atBottom) pre.scrollTop = pre.scrollHeight; // 맨 아래를 보고 있을 때만 따라 내려감 (위를 읽는 중이면 그대로)
  };
  const glassLog = (msg: string) => {
    logLines.push(`${((performance.now() - startedAt) / 1000).toFixed(1).padStart(6)}s  ${msg}`);
    if (logLines.length > 200) logLines.shift();
    renderLog();
  };
  let glassStatus = '';
  const setStatus = (s: string) => {
    glassStatus = s;
    html.dataset.glass = s;
    glassLog(s);
  };
  // 페이지가 바뀌면 <html>·<body> 가 새것으로 바뀌므로 다시 붙임
  document.addEventListener('astro:after-swap', () => {
    if (glassStatus) html.dataset.glass = glassStatus;
    renderLog();
  });

  // 유리 로고 렌더러는 필요할 때 한 번만 만듦 (WebGPU 코드는 이때 따로 불러옴).
  // 휴대폰에서 다른 앱에 갔다 오는 등으로 GPU 연결이 끊기면 다시 만들어 이어서 그림 (연달아 실패하면 몇 번까지만).
  let glass: GlassLogo | null = null;
  let glassReady: Promise<GlassLogo | null> | null = null;
  let revives = 0;
  const MAX_REVIVES = 3;
  const revive = () => {
    if (revives >= MAX_REVIVES) return setStatus('gave up — flat logo from now on');
    revives++;
    glassLog(`retry ${revives}/${MAX_REVIVES} in ${0.7 * revives}s`);
    const go = () => {
      if (homeLogo()) ensureGlass().then((g) => g && showGlassAtHome());
      // 다른 페이지에 있으면 홈으로 갈 때 다시 만듦
    };
    // 화면이 보일 때, 실패할수록 조금 더 기다렸다가 다시 시도 (백그라운드에서는 GPU 를 다시 못 받을 수 있음)
    const wait = 700 * revives;
    if (document.visibilityState === 'visible') setTimeout(go, wait);
    else document.addEventListener('visibilitychange', function once() {
      if (document.visibilityState !== 'visible') return;
      document.removeEventListener('visibilitychange', once);
      setTimeout(go, wait);
    });
  };
  const ensureGlass = () => {
    const canvas = canvasEl();
    if (!canvas) return Promise.resolve(null);
    if (!('gpu' in navigator)) {
      setStatus('no navigator.gpu');
      return Promise.resolve(null);
    }
    glassReady ??= (setStatus('loading'), import('../effects/glass-logo'))
      .then((m) =>
        m.createGlassLogo(canvas, {
          calm: calm(),
          onLog: glassLog,
          onDead: (why) => {
            setStatus(`lost — ${why}`);
            // 유리 로고가 대신 그리던 헤더 로고를 다시 보이게 (날아가던 중에 끊겼을 때)
            const mark = headerMark();
            if (mark) mark.style.visibility = '';
            glass = null;
            glassReady = null;
            revive();
          },
        }),
      )
      .then((g) => {
        setStatus(g ? 'ready' : 'unavailable');
        return (glass = g);
      })
      .catch((err) => {
        // WebGPU 장치를 못 얻으면 평면 SVG 로고만 씀
        setStatus(`error — ${err?.message ?? err}`);
        glassReady = null;
        revive(); // 잠시 뒤 다시 시도 (GPU 가 막 재시작된 직후에는 잠깐 못 받는 경우가 있음)
        return null;
      });
    return glassReady;
  };

  const showGlassAtHome = (from?: Rect) => {
    const logo = homeLogo();
    if (!glass?.alive || !logo) return;
    setStatus('on');
    glass.enterHome(() => rectOf(homeLogo() ?? logo), { from, ms: flyMs(from ? 480 : 750) });
    // 첫 프레임은 평면 SVG 로고와 같은 모습이라 바로 바꿔도 티가 나지 않음
    requestAnimationFrame(() => requestAnimationFrame(() => glass?.alive && html.classList.add('glass-on')));
  };

  // 처음 접속
  let first = true;
  document.addEventListener('astro:page-load', async () => {
    if (!first) return;
    first = false;
    if (homeLogo()) {
      if (await ensureGlass()) showGlassAtHome();
    } else {
      // 다른 페이지로 처음 들어왔으면 한가할 때 미리 준비 (홈으로 갈 때 바로 쓰도록)
      ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(() => ensureGlass());
    }
  });

  // 페이지 이동
  let nav: { fromHome: boolean; toHome: boolean; glass: boolean; fromRect?: Rect } | null = null;
  let vt: ViewTransition | undefined;

  document.addEventListener('astro:before-preparation', (e) => {
    const { from, to } = e as PrepEvent;
    const fromHome = isHome(from);
    const toHome = isHome(to);
    const crossing = fromHome !== toHome;
    // 유리 로고로 날릴 수 있는지: 나갈 땐 홈에 유리 로고가 떠 있어야, 올 땐 렌더러가 준비돼 있어야
    const useGlass = crossing && !!glass?.alive && (fromHome ? glass.atHome : true);
    nav = { fromHome, toHome, glass: useGlass };
  });

  // 화면을 캡처하기 직전 (아직 이전 페이지)
  document.addEventListener('astro:after-preparation', () => {
    if (!nav?.glass || !glass) return;
    if (nav.fromHome) {
      // 홈 로고는 페이지 전환으로 날리지 않음 (유리 로고가 대신 날아감)
      const wrap = document.querySelector<HTMLElement>('.home .logo-wrap');
      if (wrap) wrap.style.viewTransitionName = 'none';
    } else {
      // 헤더 로고 자리에 똑같은 평면 로고를 캔버스에 그려 두고, 진짜 헤더 로고는 숨김
      const mark = headerMark();
      if (mark) {
        nav.fromRect = rectOf(mark);
        mark.style.viewTransitionName = 'none';
        mark.style.visibility = 'hidden';
        glass.holdAt(nav.fromRect);
        html.classList.add('glass-on');
      }
    }
  });

  document.addEventListener('astro:before-swap', (e) => {
    vt = (e as SwapEvent).viewTransition;
  });

  // 새 페이지로 바뀐 직후 (전환 애니메이션 시작 전)
  document.addEventListener('astro:after-swap', () => {
    // 다른 페이지에서 홈으로 돌아온 경우: 로고 아래 링크를 기다리지 않고 바로 보여줌
    if (homeLogo()) html.classList.add('returning');
    const n = nav;
    nav = null;
    if (!n) return;
    // 홈에서 왔으면 헤더 메뉴도 내용과 함께 서서히 나타남 (다른 페이지끼리는 메뉴가 그대로라 바로)
    if (n.fromHome && !n.toHome) html.classList.add('came-from-home');
    if (n.glass && glass) {
      html.classList.add('glass-on'); // 새 페이지로 바뀌며 <html> 속성이 초기화되므로 다시
      if (n.fromHome) {
        // 홈 → 다른 페이지: 헤더 로고 자리로 날아가며 작아지고 평면이 됨. 도착하면 진짜 헤더 로고로 바꿈
        const mark = headerMark();
        if (!mark) return;
        mark.style.viewTransitionName = 'none';
        mark.style.visibility = 'hidden';
        glass.leave(rectOf(mark), flyMs(420)).then(() => {
          mark.style.visibility = '';
          if (!glass?.atHome) html.classList.remove('glass-on');
        });
      } else {
        // 다른 페이지 → 홈: 헤더 로고 자리에서 날아오며 커지고 유리가 됨
        const wrap = document.querySelector<HTMLElement>('.home .logo-wrap');
        if (wrap) wrap.style.viewTransitionName = 'none';
        showGlassAtHome(n.fromRect);
      }
      return;
    }
    // 유리 로고 없이: 평면 SVG 로고를 페이지 전환으로 날림
    const cls = n.toHome && !n.fromHome ? 'to-home' : n.fromHome && !n.toHome ? 'from-home' : '';
    if (cls) {
      html.classList.add(cls);
      const done = () => html.classList.remove(cls);
      if (vt) vt.finished.finally(done);
      else setTimeout(done, 1000);
    }
    // 렌더러가 아직 없으면 지금 준비해 두고, 홈에 왔다면 전환이 끝난 뒤 유리로 바꿈
    ensureGlass().then(async (g) => {
      if (!g || !n.toHome || !homeLogo()) return;
      await vt?.finished.catch(() => {});
      if (homeLogo()) showGlassAtHome();
    });
  });
</script>

<style>
  .site-header {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-top: 28px; padding-bottom: 0; flex-wrap: wrap;
  }
  .brand { font-weight: 650; letter-spacing: -0.02em; }
  nav { display: flex; gap: 20px; font-size: 0.925rem; }
  nav a { color: var(--muted); transition: color .15s; }
  nav a:hover, nav a.active { color: var(--fg); }
  .site-footer {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-bottom: 40px; font-size: 0.85rem; color: var(--faint);
  }
  .foot-links { display: flex; gap: 16px; }
  .foot-links a:hover { color: var(--fg); }
  @media (max-width: 480px) { nav { gap: 14px; } }
</style>
