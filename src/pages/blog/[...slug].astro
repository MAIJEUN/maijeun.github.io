---
import { render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getPosts, readingMinutes, formatDate } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<BlogLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-head">
      <a href="/blog" class="back">← 블로그</a>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="desc">{post.data.description}</p>}
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span> · {readingMinutes(post.body)}분 읽기</span>
        {post.data.tags.length > 0 && <span> · {post.data.tags.map((t) => `#${t}`).join(' ')}</span>}
      </p>
    </header>
    <div class="prose"><Content /></div>
  </article>

  {(older || newer) && (
    <nav class="pager" aria-label="다른 글">
      {older ? (
        <a href={`/blog/${older.id}`}>
          <span class="faint">이전 글</span>
          <span>{older.data.title}</span>
        </a>
      ) : <span />}
      {newer ? (
        <a href={`/blog/${newer.id}`} class="next">
          <span class="faint">다음 글</span>
          <span>{newer.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  )}
</BlogLayout>

<style>
  .post-head { margin-bottom: 40px; }
  .back { display: inline-block; margin-bottom: 28px; font-size: 0.875rem; color: var(--faint); }
  .back:hover { color: var(--fg); }
  .post-head h1 { font-size: clamp(1.75rem, 5vw, 2.2rem); letter-spacing: -0.03em; line-height: 1.3; margin: 0 0 10px; }
  .desc { margin: 0 0 12px; color: var(--muted); font-size: 1.05rem; }
  .meta { margin: 0; font-size: 0.875rem; color: var(--faint); font-variant-numeric: tabular-nums; }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 0.925rem;
  }
  .pager a { display: flex; flex-direction: column; gap: 2px; }
  .pager a:hover span:last-child { text-decoration: underline; text-underline-offset: 4px; }
  .next { text-align: right; }

  @media (max-width: 480px) {
    .pager { grid-template-columns: 1fr; }
    .pager > span { display: none; }
    .next { text-align: left; }
  }
</style>
