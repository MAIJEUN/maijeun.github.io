---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../data/site';
---
<Base bare>
  <main class="home">
    <h1 class="sr-only">{SITE.name}</h1>
    <div class="mark">
      <!-- 서브 페이지 헤더의 작은 로고와 같은 이름: 페이지를 오갈 때 로고가 이어져 움직임 -->
      <span class="logo-wrap" transition:name="site-logo"><Logo class="logo" size="100%" /></span>
      <nav class="home-links" aria-label="사이트">
        <a href="/blog">blog</a>
        <a href="/projects">projects</a>
        <a href="/sns">sns</a>
      </nav>
    </div>
  </main>
  <canvas class="glass" aria-hidden="true"></canvas>
</Base>

<script>
  import { mountGlassLogo, type GlassLogo } from '../effects/glass-logo';

  // 페이지 전환(ClientRouter)을 쓰기 때문에 이 스크립트는 한 번만 실행됩니다.
  // 메인에 올 때마다 유리 로고를 붙이고, 떠날 때 정리합니다.
  let ctl: GlassLogo | undefined;
  let generation = 0;
  let pendingTransition: ViewTransition | undefined;
  const html = document.documentElement;
  const logoWrap = () => document.querySelector<HTMLElement>('.home .logo-wrap');

  document.addEventListener('astro:page-load', async () => {
    const canvas = document.querySelector<HTMLCanvasElement>('canvas.glass');
    const logo = document.querySelector('.home .logo');
    if (!canvas || !logo) return;
    const my = ++generation;
    // 다른 페이지에서 왔다면 로고가 날아오는 전환이 끝난 뒤에 유리로 바꿈
    // (전환 도중에 유리 로고가 먼저 그려져 있으면 그 위로 겹쳐 보여 어색함)
    const vt = pendingTransition;
    pendingTransition = undefined;
    if (vt) await vt.finished.catch(() => {});
    if (my !== generation) return;
    try {
      const c = await mountGlassLogo(canvas, logo);
      if (!c) return;
      if (my !== generation || !canvas.isConnected) return c.dispose(); // 그새 다른 페이지로 이동함
      ctl = c;
    } catch (err) {
      // WebGPU를 못 쓰는 환경이면 그냥 SVG 로고가 보입니다.
      console.warn('[glass-logo]', err);
      html.classList.remove('glass-on');
    }
  });

  // 메인을 떠날 때: 먼저 유리 로고가 지금 기울기 그대로 얇은 단색 로고로 돌아가고 (다음 페이지를 불러오는 동안),
  document.addEventListener('astro:before-preparation', (e) => {
    const c = ctl;
    if (!c) return;
    const ev = e as Event & { loader: () => Promise<void> };
    const load = ev.loader;
    ev.loader = async () => {
      await Promise.all([c.toSolid(300), load()]);
    };
  });
  // 화면을 캡처하기 직전: 같은 기울기를 평면 SVG 로고에 CSS 3D 회전으로 옮겨 놓음.
  // 그러면 헤더 로고로 날아가는 동안 회전이 풀리며 평면이 됨.
  document.addEventListener('astro:after-preparation', () => {
    if (!ctl) return;
    const { yaw, pitch, perspective } = ctl.pose();
    const wrap = logoWrap();
    if (wrap) wrap.style.transform = `perspective(${perspective}px) rotateY(${-yaw}rad) rotateX(${-pitch}rad)`;
    html.classList.add('glass-snap');
    html.classList.remove('glass-on');
  });
  document.addEventListener('astro:before-swap', (e) => {
    pendingTransition = (e as Event & { viewTransition?: ViewTransition }).viewTransition;
    generation++;
    ctl?.dispose();
    ctl = undefined;
  });
  document.addEventListener('astro:after-swap', () => {
    html.classList.remove('glass-snap');
    // 다른 페이지에서 돌아온 경우: 링크를 기다리지 않고 바로 보여줌
    if (document.querySelector('main.home')) html.classList.add('returning');
  });
</script>

<style>
  .home {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  /* 로고는 화면 정가운데 그대로, 링크는 그 아래에 띄워 둠 */
  .mark { position: relative; }
  .logo-wrap { display: block; }
  .home :global(.logo) {
    display: block;
    width: clamp(110px, 20vw, 190px);
    height: auto;
    color: var(--fg);
  }
  .home-links {
    position: absolute;
    z-index: 1; /* 유리 로고 캔버스 위 */
    top: calc(100% + clamp(44px, 7vw, 64px));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: clamp(14px, 3vw, 22px);
    animation: fade-in 0.8s ease 1.1s both; /* 로고 등장이 끝난 뒤 서서히 */
  }
  .home-links a {
    padding: 6px 4px;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-indent: 0.24em; /* 자간 때문에 생기는 오른쪽 여백을 맞춰 가운데 정렬 */
    color: var(--faint);
    transition: color 0.2s;
  }
  .home-links a:hover, .home-links a:focus-visible { color: var(--fg); }
  .home-links a:focus-visible { outline: 1px solid var(--faint); outline-offset: 2px; border-radius: 4px; }
  :global(html.returning) .home-links { animation: none; }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .home-links { animation: none; } }

  .glass {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }
  :global(html.glass-on) .glass { opacity: 1; }
  :global(html.glass-on) .home :global(.logo) { opacity: 0; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
